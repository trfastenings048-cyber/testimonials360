// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EventImage {
  id        String   @id @default(uuid())
  url       String
  groupName String
  timestamp Float
  isVisible Boolean  @default(true)
}

model Certificate {
  id             String   @id @default(uuid())
  userName       String
  userEmail      String
  teamName       String?
  designation    String?
  groupName      String
  imageUrl       String
  certificateUrl String?
  feedback       String?
  showOnDisplay  Boolean  @default(false)
  gradient       String?
  createdAt      Float
}

model Video {
  id           String   @id @default(uuid())
  title        String
  publicId     String   @unique
  url          String
  thumbnailUrl String
  format       String
  bytes        Float
  duration     Float?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  /// Clips that belong to an ordered playlist share a setName and carry a 1-based position.
  /// Standalone uploads leave both null.
  setName      String?
  position     Int?

  @@index([createdAt])
  @@index([setName, position])
}

/// Failed admin sign-in counters, keyed by "ip:<address>" or "global". Makes a short PIN safe
/// to use by locking out repeated guessing.
model AdminLoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

model DisplaySettings {
  id                     String   @id @default("default")
  heading                String   @default("Testimonials")
  subtitle               String   @default("")
  mode                   String   @default("testimonials")
  videoUrl               String?
  videoAutoplay          Boolean  @default(true)
  videoLoop              Boolean  @default(true)
  /// The preferred sound level for video playback. Browsers still require a gesture before audio can start.
  videoMuted             Boolean  @default(false)
  videoVolume            Int      @default(68)
  /// Which video the screen plays in video mode: the latest standalone upload ("single")
  /// or the ordered clip set ("parts").
  videoSet               String   @default("single")
  testimonialAutoPlay    Boolean  @default(true)
  testimonialDurationMs  Int      @default(5000)
  updatedAt              DateTime @updatedAt
}
