// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EventImage {
  id        String   @id @default(uuid())
  url       String
  groupName String
  timestamp Float
  isVisible Boolean  @default(true)
}

model Certificate {
  id             String   @id @default(uuid())
  userName       String
  userEmail      String
  teamName       String?
  designation    String?
  groupName      String
  imageUrl       String
  certificateUrl String?
  feedback       String?
  showOnDisplay  Boolean  @default(false)
  gradient       String?
  createdAt      Float
}

model Video {
  id           String   @id @default(uuid())
  title        String
  publicId     String   @unique
  url          String
  thumbnailUrl String
  format       String
  bytes        Float
  duration     Float?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model DisplaySettings {
  id                     String   @id @default("default")
  heading                String   @default("Testimonials")
  subtitle               String   @default("")
  mode                   String   @default("testimonials")
  videoUrl               String?
  videoAutoplay          Boolean  @default(true)
  videoLoop              Boolean  @default(true)
  testimonialAutoPlay    Boolean  @default(true)
  testimonialDurationMs  Int      @default(5000)
  updatedAt              DateTime @updatedAt
}
